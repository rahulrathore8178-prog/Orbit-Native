{
  "expo": {
    "name": "Orbit-Development",
    "slug": "orbit",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/Orbit-Logo.png",
    "scheme": "orbitnative",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.orbitdevelopment.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Orbit-Logo.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.orbit.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "This app needs local network access to connect to the development backend."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Orbit-Logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera for video calls.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone for calls and voice notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Orbit-Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D8BFF"
        }
      ],
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find people nearby."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to pick photos and videos for posts.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to capture photos and videos for posts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voice notes."
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "# react-native-reanimated\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n\n# WebRTC\n-keep class org.webrtc.** { *; }\n-keep interface org.webrtc.** { *; }\n-keep class org.webrtc.**$* { *; }\n-dontwarn org.webrtc.**\n-dontwarn org.webrtc.Dav1dDecoder\n-dontwarn org.webrtc.Dav1dDecoder$Natives\n-dontwarn org.webrtc.Dav1dDecoderJni\n\n# InCallManager\n-keep class com.zxcpoiu.incallmanager.** { *; }\n-dontwarn com.zxcpoiu.incallmanager.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "509ad21b-0c8b-4b02-bb10-841f5e59c867"
      }
    },
    "owner": "orbitlives-team"
  }
}