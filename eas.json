{
    "cli": {
        "version": ">= 10.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "environment": "development",
            "env": {
                "APP_VARIANT": "development"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "environment": "preview",
            "env": {
                "APP_VARIANT": "preview"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "environment": "production",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "production"
            }
        }
    }
}